#!/usr/bin/expect -f
# 版本 v3 部署脚本
# 自动部署连连看 v3 到阿里云服务器
set timeout 120
set host "8.153.160.138"
set user "root"
set password "Ldq185522747"
set port "55503"
set remote_dir "/root/Code/lianliankan"

puts "================================"
puts "  连连看 v3 部署脚本"
puts "================================"

puts "\n>>> 步骤 [1/4] 上传文件到服务器..."
spawn rsync -avz --delete \
    --exclude ".git" \
    --exclude ".vscode" \
    --exclude ".DS_Store" \
    --exclude "__pycache__" \
    --exclude "*.pyc" \
    --exclude "upgrade_*.py" \
    --exclude "db/leaderboard.db" \
    -e "ssh -o StrictHostKeyChecking=no" \
    /Users/jokkerling/Documents/Code/lianliankan/ \
    $user@$host:$remote_dir/

expect {
    "password:" { send "$password\r"; exp_continue }
    "Password:" { send "$password\r"; exp_continue }
    timeout { puts "rsync timeout"; exit 1 }
    eof
}
puts "文件上传完成！"

puts "\n>>> 步骤 [2/4] 连接服务器..."
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect {
    "password:" { send "$password\r" }
    "Password:" { send "$password\r" }
    timeout { puts "SSH timeout"; exit 1 }
}
expect "# "

puts "\n>>> 步骤 [3/4] 安装依赖..."
send "source ~/venv/bin/activate && pip install -r $remote_dir/requirements.txt -q\r"
expect "# "

puts "\n>>> 步骤 [4/4] 重启服务..."
send "systemctl daemon-reload && systemctl restart lianliankan && sleep 3 && systemctl status lianliankan --no-pager | head -15\r"
expect "# "

puts "\n==================================="
puts "  部署完成！"
puts "  访问地址: http://8.153.160.138:55503"
puts "==================================="

send "exit\r"
expect eof
